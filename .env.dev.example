# Template for .env.dev, the local Docker stack's secrets.
# Do not fill this in by hand: run `python scripts/dev_env.py`, which writes
# .env.dev with fresh random values (gitignored). Never copy values from the
# production .env.
WEBUI_SECRET_KEY=
POSTGRES_PASSWORD=
AIUI_FERNET_KEY=
DEV_ADMIN_EMAIL=admin@local.test
DEV_ADMIN_PASSWORD=
# fake = the scripted model in dev/fake-llm; real = OpenRouter free models
# (docker-compose.dev.real.yml, needs your own OPENROUTER_API_KEY). Switching
# needs `bash scripts/dev_up.sh reset`: Open WebUI keeps its saved connection.
LOCAL_MODEL=fake
OPENROUTER_API_KEY=
